PORTWEBSITE=80
PORTDB=3306
#
# Database Container configuration
#
CONTAINER_DB_NAME=db
# Path to store your database (Volume)
DB_PATH=./data/db
PHP_MYADMIN_PATH=./data/phpmyadmin
# Root password for your database
MYSQL_ROOT_PASSWORD=toor
# Database name, user and password for your wordpress
MYSQL_HOST=db
MYSQL_DATABASE=db
MYSQL_USER=db
MYSQL_PASSWORD=db
#
# Wordpress Container configuration
#
CONTAINER_WP_NAME=wordpress-server
# Path to store your wordpress files
WP_CORE=./public/wp-core
WP_CONTENT=./public/wp-content
# Table prefix
WORDPRESS_TABLE_PREFIX=wp_
# Your domain (or domains)
DOMAINS=marketing101.dev
# Your email for Let's Encrypt register
#LETSENCRYPT_EMAIL=
WORDPRESS_DB_HOST=db
WORDPRESS_DB_NAME=db
WORDPRESS_DB_USER=db
WORDPRESS_DB_PASSWORD=db
WORDPRESS_DEBUG=true
